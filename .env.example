# Database (Docker container from docker-compose.yml)
DB_HOST=127.0.0.1
# 3307 on the host to avoid clashing with a local MySQL on 3306. Change both here and it follows.
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=playsync

# Server
PORT=4000
LEASE_MS=15000
HEARTBEAT_MS=5000
REAPER_MS=2000
DEFAULT_STRATEGY=PESSIMISTIC
APP_POOL_SIZE=20
LAB_POOL_SIZE=120
